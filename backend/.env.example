# ==============================================================================
# RasoiAI Backend Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Gemini Model Name (Recommended: gemini-2.0-flash for high speed, multimodal vision & text)
GEMINI_MODEL="gemini-2.0-flash"

# Application Settings
ENVIRONMENT="development"
PORT=8000

# Optional Supabase credentials (for cloud auth and database sync)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_JWT_SECRET=""
